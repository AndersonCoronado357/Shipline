# Login acmsy — copia este archivo a .env y rellena. NUNCA lo subas a git.

# Base de datos de ESTA app (PostgreSQL o MySQL). acmsy la inyecta al publicar.
DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos

# Secreto para firmar las sesiones (cadena larga y aleatoria, propia de cada app).
SESSION_SECRET=

# "Entrar con Google" (mismo proyecto de Google para todas las apps; ver login-google.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo (Resend) para la recuperacion de contrasena
RESEND_API_KEY=
MAIL_FROM=noreply@acmsy.com

# URL publica de la app (opcional). Por defecto: https://<subdominio>.acmsy.com
# En local: http://localhost:3000
APP_URL=
