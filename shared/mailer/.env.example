# Correo (Resend) — copia este archivo a .env y rellena los valores.
# NUNCA subas el .env a git ni lo pegues en la interfaz.

# Clave de la API de Resend (la generas en https://resend.com, seccion API Keys)
RESEND_API_KEY=

# Remitente por defecto. Recomendado: el dominio raiz verificado en Resend.
MAIL_FROM=noreply@acmsy.com
# Nombre visible del remitente (cada app puede sobreescribirlo con displayName)
MAIL_FROM_NAME=acmsy
