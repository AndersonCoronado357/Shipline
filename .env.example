# Copia este archivo a .env y completa los valores.
PORT=3000
# En producción: https://shipline.acmsy.com
APP_URL=http://localhost:3000
# Base PostgreSQL de esta app
DATABASE_URL=postgres://usuario:clave@localhost:5432/shipline
# Cadena larga aleatoria: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Opcionales (las inyecta acmsy al publicar con login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
MAIL_FROM=noreply@acmsy.com
